# API
EXPO_PUBLIC_API_URL=https://test.example.com

# Google Sign-In
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-google-client-id.apps.googleusercontent.com

# RevenueCat
EXPO_PUBLIC_RC_IOS_API_KEY=appl_your_revenuecat_ios_public_sdk_key
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_your_revenuecat_android_public_sdk_key
EXPO_PUBLIC_RC_DEFAULT_OFFERING_ID=default
EXPO_PUBLIC_RC_PRODUCT_PRO_MONTHLY=com.example.app.pro.monthly
EXPO_PUBLIC_RC_PRODUCT_PRO_YEARLY=com.example.app.pro.yearly
EXPO_PUBLIC_RC_PRODUCT_FAMILY_MONTHLY=com.example.app.family.monthly
EXPO_PUBLIC_RC_PRODUCT_FAMILY_YEARLY=com.example.app.family.yearly
EXPO_PUBLIC_RC_APP_DIAGNOSTIC_LOGS=false
EXPO_PUBLIC_RC_SDK_DEBUG_LOGS=false

# Sync policy
EXPO_PUBLIC_SYNC_BATCH_SIZE=10
EXPO_PUBLIC_SYNC_MAX_RETRIES=5
EXPO_PUBLIC_SYNC_BASE_DELAY_MS=1000
EXPO_PUBLIC_SYNC_JITTER_MS=300
EXPO_PUBLIC_SYNC_CIRCUIT_WINDOW_MS=60000
EXPO_PUBLIC_SYNC_CIRCUIT_ERROR_THRESHOLD=10
EXPO_PUBLIC_SYNC_CIRCUIT_COOLDOWN_MS=30000
EXPO_PUBLIC_LOADING_TIMEOUT=300

# Expo app/build identities
EXPO_APP_NAME=pazzwrd
EXPO_APP_SLUG=frontend
EXPO_APP_SCHEME=pmgr
EXPO_IOS_BUNDLE_IDENTIFIER=com.example.passwordclient
EXPO_ANDROID_PACKAGE=com.example.passwordclient
EXPO_EAS_PROJECT_ID=
EXPO_OWNER=
